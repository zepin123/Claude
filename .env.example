# Firebase Web SDK: valores públicos de Firebase Console > Project settings > Web app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_FUNCTIONS_REGION=us-central1

# Público: identifica la aplicación Web Push.
ONESIGNAL_APP_ID=

# SECRETO de Sites, solo servidor; habilita la notificación de prueba.
ONESIGNAL_REST_API_KEY=

# Solo informa al frontend de que el backend de Calendar está preparado.
GOOGLE_CALENDAR_ENABLED=

# Secretos de Firebase Functions (requieren despliegue y facturación Blaze).
# Configurar con `firebase functions:secrets:set`, nunca en frontend.
# ONESIGNAL_REST_API_KEY (también para recordatorios programados)
# ONESIGNAL_WEBHOOK_SECRET
# DAYRA_APP_URL
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET
# GOOGLE_OAUTH_REDIRECT_URI
# GOOGLE_TOKEN_ENCRYPTION_KEY (32 bytes en base64)
